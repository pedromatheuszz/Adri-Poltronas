# MODELO. Nao coloque valor real aqui: este arquivo e versionado. As
# credenciais vivem no cofre cifrado (%APPDATA%\AdriPoltronas\.segredos) ou no
# .env local, que o .gitignore ignora. Ver LICENCA_E_PAGAMENTO.md.
# -----------------------------------------------------------------------------
# Copie para `.env` e preencha com valores reais.
#
# ATENCAO: este arquivo e versionado no git. NUNCA coloque credenciais aqui --
# ja aconteceu uma vez (chave do Gemini, revogada; ver .gitleaksignore).
#
# REGRA DESTE ARQUIVO: so entra variavel que o codigo REALMENTE LE.
#
# Ate a 1.5.0 havia aqui cinco variaveis de "SEGURANCA AVANCADA" --
# ADRI_HMAC_SECRET, ADRI_ALLOWED_IPS, ADRI_SESSION_TIMEOUT,
# ADRI_LOGIN_ATTEMPTS, ADRI_REQUEST_TIMEOUT -- que nenhuma linha do backend
# consultava. Um operador que lesse "IP permitido para acesso" e preenchesse a
# variavel de allowlist com o proprio loopback acreditava ter restringido o
# acesso por IP, e nao tinha restringido nada. Configuracao que promete e nao
# entrega e pior do que configuracao ausente: calibra a confianca errado, e faz
# isso justamente no arquivo que se copia e se compartilha.
#
# `tests/test_configuracao.py` faz a suite falhar se uma variavel ADRI_ voltar
# a ser documentada aqui sem existir no codigo.
# -----------------------------------------------------------------------------

# Chave de assinatura de sessao do Flask.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
ADRI_FLASK_SECRET=

# Chave Fernet, usada como reserva quando o DPAPI nao esta disponivel
# (desenvolvimento fora do Windows, CI). Em producao quem cifra e o DPAPI.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# OAuth Microsoft (OneDrive/Excel) - ID publico do app registrado no Azure AD.
ADRI_MICROSOFT_CLIENT_ID=14bc533a-a8a2-4e2b-9142-773dcd117269

# IA - Gemini API (fallback de sugestao de bairro quando o ViaCEP falha).
GEMINI_API_KEY=

# Banco de dados (opcional - usa %APPDATA%/AdriPoltronas/ por padrao).
ADRI_DB_PATH=

# PERIGO: permite rodar com o banco em pasta de rede (UNC ou unidade
# mapeada). O SQLite corrompe em compartilhamento SMB -- o app recusa a
# abrir nessa configuracao, e esta variavel existe so para quem le isto,
# entende o risco e assume a recuperacao manual por conta propria.
ADRI_PERMITIR_BANCO_EM_REDE=

# Contas Microsoft autorizadas a usar o sistema, separadas por virgula.
#
# VAZIO = qualquer conta Microsoft entra, que e o comportamento historico. O
# fluxo OAuth usa o endpoint /common e aceita conta pessoal ou de qualquer
# tenant, entao sem esta lista um colaborador que conecte a conta dele passa a
# ser, para o sistema, o mesmo que o dono.
#
# Preencha com o e-mail de quem realmente opera. A comparacao ignora
# maiusculas e espacos sobrando.
ADRI_CONTAS_AUTORIZADAS=

# Pasta extra para onde copiar os backups (opcional): um pendrive ou uma pasta
# sincronizada, para o caso em que a maquina inteira se perde.
ADRI_BACKUP_EXTRA=

# Senha das copias que vao para a pasta extra (12 caracteres ou mais). Sem ela
# a copia externa so abre nesta conta do Windows e nao serve para recuperar
# depois de perder o computador. Anote-a fora da maquina.
ADRI_BACKUP_SENHA=

# ---------------------------------------------------------------------------
# Licenca de uso - Mercado Pago
# ---------------------------------------------------------------------------
# Access Token da aplicacao (NAO a Public Key). Ver LICENCA_E_PAGAMENTO.md
# para grava-lo cifrado, sem passar por arquivo de texto.
MP_ACCESS_TOKEN=

# Endereco da API do Mercado Pago (opcional). Vazio significa producao.
# Serve para apontar a um duble local e exercitar o fluxo de cobranca inteiro
# sem mexer com dinheiro de verdade.
MP_API_URL=

# -----------------------------------------------------------------------------
# Chave Render usada pelo wrapper administrativo local (`render-api`).
# Crie uma chave dedicada e com permissões mínimas no painel do Render.
KEY_RENDER=

# -----------------------------------------------------------------------------
# API central de licenças (ver licensing-service/README.md)
# -----------------------------------------------------------------------------
# O banco contém dados pessoais. Se o Windows confirmar que o disco não tem
# BitLocker, o sistema não inicia. Defina 1 somente se você assumir o risco.
ADRI_PERMITIR_BANCO_SEM_BITLOCKER=0
# Configure a URL HTTPS pública nas instalações do vendedor e dos clientes.
ADRI_LICENCA_API_URL=https://adri-poltronas-licenses.onrender.com
# Token administrativo somente no computador do fornecedor. Mantenha vazio
# nas instalações de clientes; nunca publique o valor real.
# ADRI_LICENCA_ADMIN_TOKEN=
