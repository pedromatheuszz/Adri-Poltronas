# -----------------------------------------------------------------------------
# Modelo de configuracao. Copie para `.env` e preencha com valores reais.
#
# ATENCAO: este arquivo e versionado no git. NUNCA coloque credenciais aqui.
# O arquivo `.env` (com os valores reais) esta no .gitignore.
# -----------------------------------------------------------------------------

# Chave de assinatura de sessao do Flask.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
ADRI_FLASK_SECRET=

# OAuth Microsoft (OneDrive/Excel) - ID publico do app registrado no Azure AD.
ADRI_MICROSOFT_CLIENT_ID=14bc533a-a8a2-4e2b-9142-773dcd117269

# IA - Gemini API (fallback de sugestao de bairro quando o ViaCEP falha).
GEMINI_API_KEY=

# Pagamentos - Asaas.
# ASAAS_SANDBOX=true  -> usa api-sandbox.asaas.com e exige uma chave $aact_hmlg_*
# ASAAS_SANDBOX=false -> usa api.asaas.com e exige uma chave $aact_prod_*
ASAAS_API_KEY=
ASAAS_SANDBOX=true

# Token de autenticacao do webhook Asaas.
# Definido ao criar o webhook no painel do Asaas e enviado por ele no header
# `asaas-access-token`. Precisa ser um valor forte e DIFERENTE da ASAAS_API_KEY.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ASAAS_WEBHOOK_TOKEN=

# Banco de dados (opcional - usa %APPDATA%/AdriPoltronas/ por padrao)
ADRI_DB_PATH=
