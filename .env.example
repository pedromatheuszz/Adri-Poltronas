# MODELO. Nao coloque valor real aqui: este arquivo e versionado e o
# repositorio e publico. As credenciais vivem no cofre cifrado
# (%APPDATA%\AdriPoltronas\.segredos) ou no .env local, que o .gitignore
# ignora. Ver LICENCA_E_PAGAMENTO.md.
# -----------------------------------------------------------------------------
# Modelo de configuracao. Copie para `.env` e preencha com valores reais.
#
# ATENCAO: este arquivo e versionado no git. NUNCA coloque credenciais aqui.
# O arquivo `.env` (com os valores reais) esta no .gitignore.
#
# SEGURANCA:
# - Gere todas as chaves com tools seguras.
# - ADRI_FLASK_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
# - FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------

# Chave de assinatura de sessao do Flask.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
ADRI_FLASK_SECRET=

# Chave Fernet para criptografia adicional de dados sensíveis.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# OAuth Microsoft (OneDrive/Excel) - ID publico do app registrado no Azure AD.
ADRI_MICROSOFT_CLIENT_ID=14bc533a-a8a2-4e2b-9142-773dcd117269

# IA - Gemini API (fallback de sugestao de bairro quando o ViaCEP falha).
GEMINI_API_KEY=



# Banco de dados (opcional - usa %APPDATA%/AdriPoltronas/ por padrao)
ADRI_DB_PATH=

# ---------------------------------------------------------------------------
# SEGURANCA AVANCADA (opcional)
# ---------------------------------------------------------------------------
# Chave de assinatura HMAC para validacao de integridade de requests.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
ADRI_HMAC_SECRET=

# IP permitido para acesso (opcional - deixe vazio para permitir todos)
# ADRI_ALLOWED_IPS=127.0.0.1,::1

# Tempo de expiracao da sessao em segundos (default: 28800 = 8 horas)
# ADRI_SESSION_TIMEOUT=28800

# Limite de tentativas de login antes de bloqueio (default: 5)
# ADRI_LOGIN_ATTEMPTS=5

# Timeout em segundos para requests externos (default: 15)
# ADRI_REQUEST_TIMEOUT=15

# Licenca de uso - Mercado Pago.
# Access Token da aplicacao (NAO a Public Key). Ver LICENCA_E_PAGAMENTO.md
# para grava-lo cifrado, sem passar por arquivo de texto.
MP_ACCESS_TOKEN=
