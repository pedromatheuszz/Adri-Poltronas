<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AdriPoltronas.Desktop.ViewModels"
        x:Class="AdriPoltronas.Desktop.Views.ClienteDialog"
        x:DataType="vm:ClienteFormViewModel"
        Title="{Binding Titulo}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource Fundo}">

  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="{Binding Titulo}" Classes="titulo" Margin="0,0,0,6" />

    <TextBlock Text="Nome" Classes="fraco" />
    <TextBox Text="{Binding Nome}" />

    <TextBlock Text="CEP" Classes="fraco" />
    <TextBox Text="{Binding Cep}" Watermark="00000-000" />

    <TextBlock Text="Rua" Classes="fraco" />
    <TextBox Text="{Binding Rua}" />

    <Grid ColumnDefinitions="*,12,*">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Bairro" Classes="fraco" />
        <TextBox Text="{Binding Bairro}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="Cidade" Classes="fraco" />
        <TextBox Text="{Binding Cidade}" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Tipo" Classes="fraco" />
    <ComboBox ItemsSource="{Binding TiposDisponiveis}" SelectedItem="{Binding Tipo}"
              HorizontalAlignment="Stretch" />

    <TextBlock Text="Observacoes" Classes="fraco" />
    <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" Height="70"
             TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancelar" Click="AoCancelar" />
      <!-- Unica validacao da tela: sem nome nao ha o que enviar. O resto e
           conferido no Domain e volta como mensagem. -->
      <Button Content="Salvar" Click="AoSalvar" IsEnabled="{Binding PodeSalvar}"
              Background="{DynamicResource Destaque}" />
    </StackPanel>
  </StackPanel>
</Window>
