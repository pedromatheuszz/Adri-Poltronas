<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AdriPoltronas.Desktop.ViewModels"
             xmlns:dto="clr-namespace:AdriPoltronas.Application.Dtos;assembly=AdriPoltronas.Application"
             x:Class="AdriPoltronas.Desktop.Views.PagamentosView"
             x:DataType="vm:PagamentosViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto"
          Margin="0,0,0,14">
      <TextBox Grid.Column="0" Text="{Binding FiltroDeCliente}"
               Watermark="Filtrar por cliente..." />
      <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="130"
                ItemsSource="{Binding StatusDisponiveis}"
                SelectedItem="{Binding FiltroDeStatus}" />
      <Button Grid.Column="2" Classes="primario" Content="Novo" Margin="8,0,0,0"
              Command="{Binding NovoCommand}" IsEnabled="{Binding !Ocupado}" />
      <Button Grid.Column="3" Content="Confirmar" Margin="8,0,0,0"
              Command="{Binding ConfirmarCommand}" IsEnabled="{Binding !Ocupado}" />
      <Button Grid.Column="4" Content="Cobranca" Margin="8,0,0,0"
              ToolTip.Tip="Emitir Pix ou boleto pelo provedor de cobranca"
              Command="{Binding GerarCobrancaCommand}" IsEnabled="{Binding !Ocupado}" />
      <Button Grid.Column="5" Content="Cancelar" Margin="8,0,0,0"
              Command="{Binding CancelarCommand}" IsEnabled="{Binding !Ocupado}" />
      <Button Grid.Column="6" Classes="perigo" Content="Excluir" Margin="8,0,0,0"
              Command="{Binding ExcluirCommand}" IsEnabled="{Binding !Ocupado}" />
    </Grid>

    <Panel Grid.Row="1">
      <DataGrid ItemsSource="{Binding Pagamentos}"
                SelectedItem="{Binding Selecionado}"
                IsReadOnly="True" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Cliente" Width="*"
                              Binding="{Binding ClienteNome, x:DataType=dto:PagamentoDto}" />
          <DataGridTextColumn Header="Valor" Width="Auto"
                              Binding="{Binding ValorFormatado, x:DataType=dto:PagamentoDto}" />
          <DataGridTextColumn Header="Descricao" Width="*"
                              Binding="{Binding Descricao, x:DataType=dto:PagamentoDto}" />
          <DataGridTextColumn Header="Status" Width="Auto"
                              Binding="{Binding Status, x:DataType=dto:PagamentoDto}" />
          <DataGridTextColumn Header="Tipo" Width="Auto"
                              Binding="{Binding Tipo, x:DataType=dto:PagamentoDto}" />
          <DataGridTextColumn Header="Vencimento" Width="Auto"
                              Binding="{Binding DataVencimento, x:DataType=dto:PagamentoDto}" />
          <DataGridTextColumn Header="Data" Width="Auto"
                              Binding="{Binding DataExibida, x:DataType=dto:PagamentoDto}" />
        </DataGrid.Columns>
      </DataGrid>

      <StackPanel IsVisible="{Binding ListaVazia}" Spacing="6"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsHitTestVisible="False">
        <TextBlock Text="Nenhum lancamento" Classes="subtitulo"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Registre um recebimento com Ctrl+N." Classes="fraco"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Panel>

    <!-- Totais por situacao, no rodape da lista, como na interface web. -->
    <UniformGrid Grid.Row="2" Columns="3" Height="84" Margin="0,14,0,16">
      <Border Classes="cartao" Margin="0,0,6,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Metricas.TotalRecebido, StringFormat=\{0:C2\}}"
                     Classes="numero" FontSize="20"
                     Foreground="{DynamicResource Entrega}" />
          <TextBlock Classes="fraco"
                     Text="{Binding Metricas.QuantidadeRecebida, StringFormat='Recebido ({0})'}" />
        </StackPanel>
      </Border>
      <Border Classes="cartao" Margin="6,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Metricas.TotalPendente, StringFormat=\{0:C2\}}"
                     Classes="numero" FontSize="20"
                     Foreground="{DynamicResource Retirada}" />
          <TextBlock Classes="fraco"
                     Text="{Binding Metricas.QuantidadePendente, StringFormat='Pendente ({0})'}" />
        </StackPanel>
      </Border>
      <Border Classes="cartao" Margin="6,0,0,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Metricas.TotalAtrasado, StringFormat=\{0:C2\}}"
                     Classes="numero" FontSize="20"
                     Foreground="{DynamicResource Perigo}" />
          <TextBlock Text="Em atraso" Classes="fraco" />
        </StackPanel>
      </Border>
    </UniformGrid>
  </Grid>
</UserControl>
