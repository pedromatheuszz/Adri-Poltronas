# =============================================================================
# MODELO DE CONFIGURAÇÃO - API CENTRAL DE LICENÇAS
# =============================================================================
# Copie para `.env` e preencha com valores reais.
#
# Para hospedar gratuitamente (Opção 1):
# 1. Crie um banco PostgreSQL gratuito no Neon (https://neon.tech)
# 2. Copie a Connection String (URI) fornecida pelo Neon para DATABASE_URL
# 3. No Render/Koyeb, configure as variáveis de ambiente DATABASE_URL e LICENSE_ADMIN_TOKEN
# =============================================================================

# URL de conexão ao PostgreSQL (ex: Neon.tech)
# Formato: postgresql://usuario:senha@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Token administrativo secreto para o desenvolvedor gerenciar licenças.
# Precisa ter no mínimo 40 caracteres (gere 32 bytes hexadecimais aleatórios):
# python -c "import secrets; print(secrets.token_hex(32))"
LICENSE_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Se for hospedar com Docker Compose próprio + Caddy (VPS própria / Opção 2):
# -----------------------------------------------------------------------------
# Domínio público com registro DNS tipo A/AAAA apontando para seu IP:
APP_DOMAIN=licencas.suaempresa.com
# Senha para o container Postgres interno do Docker Compose:
POSTGRES_PASSWORD=
