{
  "name": "adri-poltronas",
  "version": "1.5.0-beta",
  "description": "Gestao de clientes, entregas e pagamentos da Adri Poltronas",
  "author": "Pedro Matheus",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.adripoltronas.app",
    "productName": "Adri Poltronas",
    "directories": {
      "output": "dist-instalador",
      "buildResources": "."
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/AdriPoltronasBackend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icone_sistema.ico",
      "signtoolOptions": {
        "publisherName": "Pedro Matheus - Programmer & Developer"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Adri Poltronas",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Adri Poltronas",
      "artifactName": "AdriPoltronasSetup-${version}.${ext}"
    },
    "copyright": "Pedro Matheus - Programmer & Developer"
  }
}
