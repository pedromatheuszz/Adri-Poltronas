# .env.example para segredos próprios do wrapper.
# Na cópia local deste repositório, a chave Render vem de KEY_RENDER no .env
# da raiz. RENDER_API_KEY é somente um fallback para deploy independente.
# Use uma chave dedicada, com as permissões mínimas necessárias.
RENDER_API_KEY=

# Segredo aleatório de pelo menos 32 caracteres. Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
