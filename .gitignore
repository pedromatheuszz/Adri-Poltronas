# --- Python / PyInstaller ---
__pycache__/
*.py[cod]
*$py.class
*.spec.bak

# Builds do PyInstaller (já versionados pelos .spec no raiz; ignorar artefatos)
build/
dist/
*.exe
*.app

# Banco de dados local (gerado em runtime; em produção vai para %APPDATA%)
*.db
*.db-journal
# SQLite em modo WAL gera companheiros -wal/-shm que chegam a dezenas de MB.
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Estado de ferramentas locais (não faz parte do código-fonte)
.freebuff/

# Ambiente virtual
.venv/
venv/
env/
ENV/
.uv-cache/
.python-version

# --- Editores / IDEs ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs e arquivos temporários ---
*.log
*.tmp
*.bak
*.old
*.orig

# --- Credenciais e segredos locais ---
.env
.env.local
*.pem
*.key
*.pfx
*.p12

# --- Electron / Node ---
node_modules/
# Saida do `tsc` (o fonte versionado fica em electron/).
dist-electron/
# Instalador gerado pelo electron-builder.
dist-instalador/

# --- Qt / CMake ---
# Saida do CMake (o fonte versionado fica em qt-app/src).
qt-app/build/

# --- .NET / Avalonia ---
# Saida de compilacao; o fonte versionado fica em dotnet/src e dotnet/tests.
[Bb]in/
[Oo]bj/
*.user
.vs/
# Resultados de teste e cobertura do dotnet test.
[Tt]est[Rr]esults/

# --- Cobertura de testes ---
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.tox/

# --- Documentação gerada ---
docs/_build/
site/

# --- Frontend: se houver build de assets ---
*.min.js
*.min.css
.DS_Store

# --- Uploads temporários do usuário ---
uploads/
*.xls.tmp

# --- Artefatos acidentais de shell no Windows ---
# `> nul` no Git Bash cria um arquivo literal chamado `_nul`/`nul`.
_nul
nul
output.txt

# Backups locais: contem o banco com dados reais de clientes.
backup/

# Cofre das credenciais de integracao (cifrado, mas nao entra aqui).
.segredos
.env.bak
